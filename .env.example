# Public site URL (used for SEO, sitemap, OpenGraph). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# --- Contact form email (optional) ---
# Provider for the /api/contact route. Currently supports "resend" or empty (logs only).
CONTACT_PROVIDER=
# Resend API key (https://resend.com) — only needed if CONTACT_PROVIDER=resend
RESEND_API_KEY=
# Where contact submissions are delivered
CONTACT_TO_EMAIL=you@your-domain.com
# Verified sender address for your provider
CONTACT_FROM_EMAIL=portfolio@your-domain.com

# --- Analytics (optional) ---
# Toggle in src/data/config.ts; this is only the domain for Plausible if used.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# --- Dev Profile / GitHub aggregation (for /dev) ---
# One Personal Access Token PER GitHub account you list in src/data/devprofile.ts.
# The var name must match that account's `tokenEnv`. Required to count PRIVATE
# contributions (the token must belong to that account). Scopes: read:user, repo.
# Also enable per account: GitHub Settings → "Include private contributions on my profile".
# Classic token: https://github.com/settings/tokens
# Put the REAL values in .env.local (gitignored) — never commit tokens here.
GITHUB_TOKEN_PERSONAL=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_TOKEN_EVA=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Competitive programming live stats ---
# No keys needed — Codeforces/LeetCode/AtCoder are fetched anonymously and the
# scrape-only platforms fall back to the values in src/data/competitive.ts.
