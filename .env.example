# Public site URL (used for SEO, sitemap, OpenGraph). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# --- Contact form email (optional) ---
# Provider for the /api/contact route. Currently supports "resend" or empty (logs only).
CONTACT_PROVIDER=
# Resend API key (https://resend.com) — only needed if CONTACT_PROVIDER=resend
RESEND_API_KEY=
# Where contact submissions are delivered
CONTACT_TO_EMAIL=you@your-domain.com
# Verified sender address for your provider
CONTACT_FROM_EMAIL=portfolio@your-domain.com

# --- Analytics (optional) ---
# Toggle in src/data/config.ts; this is only the domain for Plausible if used.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
